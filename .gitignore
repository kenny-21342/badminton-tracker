# Model weights. Fetched by download_tracknet.py (TrackNet, ~130 MB) or by
# ultralytics on first use (yolov8n.pt, 6 MB) — large, binary, and
# reproducible from their release URLs, so not committed.
models/
*.pt

# Training output and labelled footage (~307 MB combined). Regenerable, and
# the clips are not ours to redistribute.
datasets/
runs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# Match footage dropped in the repo root for a one-off analysis run. Large
# (hundreds of MB each), and broadcast video is not ours to redistribute --
# same reason datasets/ is ignored above.
*.mp4
*.mov
*.mkv

# PyInstaller output. The .app is ~940 MB (most of it Torch) and is rebuilt
# from BadmintonTracker.spec with:
#   python3 -m PyInstaller --noconfirm BadmintonTracker.spec
build/
dist/
